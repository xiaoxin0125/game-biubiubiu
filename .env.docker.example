# Copy to .env.docker, replace every CHANGE_ME value, then run:
# docker compose --env-file .env.docker pull app
# docker compose --env-file .env.docker up -d --no-build

# ---- Public application address ----
# Keep APP_BIND_IP=127.0.0.1 when Nginx/Caddy on the host provides HTTPS.
# Use 0.0.0.0 only for direct access (HTTPS is still strongly recommended for WebRTC).
APP_BIND_IP=127.0.0.1
APP_PORT=3000
CSRF_ALLOWED_ORIGINS=https://game.example.com
TRUST_PROXY=1
TZ=Asia/Shanghai

# ---- Application bootstrap ----
# ADMIN_PASSWORD must be at least 12 characters. It only seeds an empty database.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=CHANGE_ME_admin_password_at_least_12_chars

# ---- MySQL ----
MYSQL_DATABASE=games_online
MYSQL_USER=games
MYSQL_PASSWORD=CHANGE_ME_mysql_app_password
MYSQL_ROOT_PASSWORD=CHANGE_ME_mysql_root_password

# ---- Public STUN/TURN address ----
# TURN_PUBLIC_HOST may be a DNS name or public IP and is provided to browsers at runtime.
# If using Cloudflare DNS, this record must be DNS-only (grey cloud), not proxied.
# TURN_PUBLIC_IP must be the server's numeric public IPv4 address for coturn.
TURN_PUBLIC_HOST=turn.example.com
TURN_PUBLIC_IP=203.0.113.10
TURN_REALM=games-online
TURN_PORT=3478
TURN_MIN_PORT=49160
TURN_MAX_PORT=49200
TURN_USERNAME=games
TURN_PASSWORD=CHANGE_ME_turn_password

# These VITE_ values are loaded by the browser at container start time. Compose
# derives the STUN/TURN URLs and credentials above automatically. Override only
# when using an external TURN server or custom ICE configuration.
# VITE_WEBRTC_STUN_URLS=stun:turn.example.com:3478
# VITE_WEBRTC_TURN_URLS=turn:turn.example.com:3478?transport=udp,turn:turn.example.com:3478?transport=tcp
VITE_WEBRTC_FORCE_RELAY=0

# Optional resource limits
MAX_UPLOAD_BYTES=104857600
MAX_STATE_BYTES=8388608
USER_UPLOAD_QUOTA_BYTES=2147483648
MAX_SAVE_SLOT=9

# Optional application config file mounted from ./config.
# Leave empty to auto-detect /app/config/app.env or /app/config/app.json.
# Values in that file override the corresponding application environment variables.
APP_CONFIG_FILE=

# Optional image name. The default is the image published by GitHub Actions.
APP_IMAGE=ghcr.io/xiaoxin0125/game-biubiubiu:latest