{
  "name": "games-online",
  "version": "1.7.2",
  "private": true,
  "type": "module",
  "workspaces": [
    "frontend"
  ],
  "scripts": {
    "dev": "node --import ./server/config.js ./node_modules/concurrently/dist/bin/concurrently.js -n api,web -c blue,magenta \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "node --import ./server/config.js --watch server/index.js",
    "dev:web": "node server/wait-api.js && npm --workspace frontend run dev",
    "build": "npm --workspace frontend run build",
    "db:import:sqlite": "node --import ./server/config.js server/db/import-sqlite-to-mysql.js",
    "preview": "npm --workspace frontend run preview",
    "security:matrix": "node server/security-matrix.js",
    "start": "node --import ./server/config.js server/index.js",
    "test": "node --test tests/*.test.js",
    "lint": "eslint .",
    "test:coverage": "node --test --experimental-test-coverage tests/*.test.js"
  },
  "dependencies": {
    "@hono/node-server": "^1.19.17",
    "@hono/node-ws": "^1.3.1",
    "bcryptjs": "^3.0.3",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.13.13",
    "mysql2": "^3.24.6",
    "nanoid": "^5.1.16",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "concurrently": "^9.2.1",
    "drizzle-kit": "^0.31.10",
    "eslint": "^10.12.0",
    "eslint-plugin-vue": "^10.11.1"
  }
}
