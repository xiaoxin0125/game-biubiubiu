{
  "name": "games-online",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "frontend"
  ],
  "scripts": {
    "dev": "concurrently -n api,web -c blue,magenta \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "node --watch server/index.js",
    "dev:web": "node server/wait-api.js && npm --workspace frontend run dev",
    "build": "npm --workspace frontend run build",
    "db:import:sqlite": "node server/db/import-sqlite-to-mysql.js",
    "preview": "npm --workspace frontend run preview",
    "start": "node server/index.js"
  },
  "dependencies": {
    "@hono/node-server": "^1.19.14",
    "@hono/node-ws": "^1.3.0",
    "bcryptjs": "^3.0.3",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.12.14",
    "mysql2": "^3.14.3",
    "nanoid": "^5.1.9",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "concurrently": "^9.2.1",
    "drizzle-kit": "^0.31.10"
  }
}
