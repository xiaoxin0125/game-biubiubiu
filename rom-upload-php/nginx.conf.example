# 宝塔 / Nginx 站点配置片段
#
# 用法（宝塔面板）：
#   1) 网站 → 添加站点，PHP 版本选 7.4 以上，站点根目录指向本目录；
#   2) 网站 → 设置 → 伪静态，粘贴下面【伪静态】部分；
#   3) 网站 → 设置 → 配置文件，在 server { } 里补上【server 内】的几行
#      （client_max_body_size 与 fastcgi 超时；宝塔默认 1m/60s，大 ROM 会传不上去）；
#   4) 数据目录与 config.json 禁止外部访问：把【server 内】的两行一起加上。
#
# 注意：不要在面板里重复添加 location ~ \.php$，宝塔已经 include 了 PHP 配置；
# 需要改超时的话，既可以在 server {} 里写 fastcgi_read_timeout（对下面所有 location 生效），
# 也可以直接改 /www/server/nginx/conf/enable-php-82.conf。

# ── server 内（放在 server {} 里、location 之外） ──────────────────────
# client_max_body_size 200m;
# fastcgi_read_timeout 600s;
# fastcgi_send_timeout 600s;
# location ^~ /data/ { deny all; }
# 配置文件里有 token 与 downloadSecret：被当成静态文件发出去就等于泄露密钥。
# 更彻底的做法是把配置放到站点目录之外，用环境变量 ROM_UPLOAD_CONFIG 指过去。
# location = /config.json { return 404; }
# location = /config.example.json { return 404; }

# ── 伪静态（宝塔「伪静态」文本框） ─────────────────────────────────────
location / {
    try_files $uri $uri/ /index.php?$query_string;
}
