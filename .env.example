# ---- Server ----
PORT=3000
NODE_ENV=development

# ---- First-boot admin ----
# In production ADMIN_PASSWORD is required and must be at least 12 characters.
# Regular /register users are always normal users; admin role is only seeded on an empty database
# or assigned later by an existing admin.
ADMIN_USERNAME=admin
# ADMIN_PASSWORD=please-change-this-strong-password

# ---- HTTP security ----
# Set TRUST_PROXY=1 only when the app is behind a trusted reverse proxy that clears spoofed headers.
TRUST_PROXY=0
# Comma-separated extra allowed origins for write requests, e.g. https://games.example.com
CSRF_ALLOWED_ORIGINS=
# Production defaults to requiring Origin on unsafe methods. Set to 0 only for trusted non-browser clients.
CSRF_REQUIRE_ORIGIN=1

# ---- Auth policy ----
# User passwords must be 10-128 chars and include lowercase, uppercase and number.
# Auth endpoints also apply IP+username in-memory throttling.

# ---- Upload limits ----
MAX_UPLOAD_BYTES=104857600   # 100 MB per ROM upload
MAX_STATE_BYTES=8388608      # 8 MB per save-state upload
USER_UPLOAD_QUOTA_BYTES=2147483648 # 2 GB total live ROM quota per normal user
MAX_SAVE_SLOT=9

# ---- Database ----
# Example: mysql://user:password@127.0.0.1:3306/games_online
DATABASE_URL=mysql://games:games@127.0.0.1:3306/games_online

# ---- Data paths (default relative to project root) ----
UPLOADS_DIR=data/uploads
BIOS_DIR=data/bios
SAVES_DIR=data/saves
CORES_DIR=data/cores

# ---- WebRTC relay for cross-network rooms ----
# STUN only works when NAT traversal succeeds. For players on different networks,
# configure a TURN service so video/audio/input can relay through it.
# Comma-separated STUN/TURN URL lists are supported.
VITE_WEBRTC_STUN_URLS=stun:stun.l.google.com:19302,stun:stun.cloudflare.com:3478
# VITE_WEBRTC_TURN_URLS=turn:turn.example.com:3478?transport=udp,turn:turn.example.com:3478?transport=tcp,turns:turn.example.com:5349?transport=tcp
# VITE_WEBRTC_TURN_USERNAME=games
# VITE_WEBRTC_TURN_CREDENTIAL=change-this-turn-secret
# Set to 1 only when testing TURN relay itself.
VITE_WEBRTC_FORCE_RELAY=0
# Alternative full JSON form. When set, it overrides the split variables above.
# VITE_WEBRTC_ICE_SERVERS=[{"urls":["stun:stun.l.google.com:19302"]},{"urls":["turn:turn.example.com:3478?transport=udp"],"username":"games","credential":"change-this-turn-secret"}]

# ---- Vite dev-only ----
VITE_API_TARGET=http://localhost:3000
