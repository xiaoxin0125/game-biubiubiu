# ---- Optional config file ----
# npm start and npm run dev auto-detect config/.env, config/app.env, config/app.json, then .env.
# APP_CONFIG_FILE=/absolute/path/to/app.json

# ---- Server ----
# Production behind local Nginx: use HOST=127.0.0.1 and NODE_ENV=production.
HOST=0.0.0.0
PORT=3000
NODE_ENV=development

# ---- First-boot admin ----
# In production ADMIN_PASSWORD is required and must be at least 6 characters.
# Regular /register users are always normal users; admin role is only seeded on an empty database
# or assigned later by an existing admin.
ADMIN_USERNAME=admin
# ADMIN_PASSWORD=please-change-this-strong-password

# ---- HTTP security ----
# Set TRUST_PROXY=1 only when the app is behind a trusted reverse proxy that clears spoofed headers.
TRUST_PROXY=0
# Comma-separated extra allowed origins for write requests, e.g. https://games.example.com
CSRF_ALLOWED_ORIGINS=
# Production defaults to requiring Origin on unsafe methods. Set to 0 only for trusted non-browser clients.
CSRF_REQUIRE_ORIGIN=1

# ---- Auth policy ----
# User passwords must be at least 6 characters.
# Auth endpoints also apply IP+username in-memory throttling.

# ---- Upload limits ----
MAX_UPLOAD_BYTES=104857600   # 100 MB per ROM upload
MAX_STATE_BYTES=8388608      # 8 MB per save-state upload
USER_UPLOAD_QUOTA_BYTES=2147483648 # 2 GB total live ROM quota per normal user
MAX_SAVE_SLOT=9

# ---- Database ----
# Example: mysql://user:password@127.0.0.1:3306/games_online
DATABASE_URL=mysql://games:games@127.0.0.1:3306/games_online

# ---- Data paths (default relative to project root) ----
UPLOADS_DIR=data/uploads
BIOS_DIR=data/bios
SAVES_DIR=data/saves
CORES_DIR=data/cores

# ---- Optional WebRTC relay ----
# STUN is configured in Admin > Site settings, saved in the database, and empty by default.
# Website deployment and single-player games do not require STUN/TURN.
# TURN can be configured later if cross-network rooms need a relay.
VITE_WEBRTC_TURN_URLS=
VITE_WEBRTC_TURN_USERNAME=
VITE_WEBRTC_TURN_CREDENTIAL=
VITE_WEBRTC_FORCE_RELAY=0
# Optional full ICE JSON; leave empty to use the STUN addresses from site settings.
VITE_WEBRTC_ICE_SERVERS=

# ---- Vite dev-only ----
VITE_API_TARGET=http://localhost:3000
