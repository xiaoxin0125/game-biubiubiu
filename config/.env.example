# Copy this file to /www/wwwroot/game-biu/config/.env and replace every CHANGE_ME value.
# Run Compose from the source directory with:
# docker compose --env-file /www/wwwroot/game-biu/config/.env -f /www/wwwroot/game/compose.yaml up -d --no-build

# ---- Public application address ----
# Configure the public listener or reverse proxy according to your deployment.
APP_BIND_IP=0.0.0.0
APP_PORT=32741
CSRF_ALLOWED_ORIGINS=https://game.example.com
TRUST_PROXY=1
TZ=Asia/Shanghai

# ---- Application bootstrap ----
# ADMIN_PASSWORD must be at least 12 characters. It only seeds an empty database.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=CHANGE_ME_admin_password_at_least_12_chars

# ---- MySQL ----
MYSQL_DATABASE=games_online
MYSQL_USER=games
MYSQL_PASSWORD=CHANGE_ME_mysql_app_password
MYSQL_ROOT_PASSWORD=CHANGE_ME_mysql_root_password

# ---- Public STUN/TURN address ----
# Replace the example addresses with the addresses used by your deployment.
TURN_PUBLIC_HOST=turn.example.com
TURN_PUBLIC_IP=203.0.113.25
TURN_LISTENING_IP=192.0.2.25
TURN_RELAY_IP=192.0.2.25
TURN_REALM=games-online
TURN_PORT=45123
TURN_MIN_PORT=45124
TURN_MAX_PORT=45129
TURN_USERNAME=games
TURN_PASSWORD=CHANGE_ME_turn_password

# Compose supplies the VITE_WEBRTC_* values from the TURN settings at runtime.
VITE_WEBRTC_FORCE_RELAY=0

# ---- Application limits ----
MAX_UPLOAD_BYTES=104857600
MAX_STATE_BYTES=8388608
USER_UPLOAD_QUOTA_BYTES=2147483648
MAX_SAVE_SLOT=9

# Keep the application config in this same file inside the mounted config directory.
APP_CONFIG_FILE=/app/config/.env

# ---- Image ----
APP_IMAGE=ghcr.io/xiaoxin0125/game-biubiubiu:latest