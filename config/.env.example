# Copy this file to /www/wwwroot/game-biu/config/.env and replace every CHANGE_ME value.
# Start Compose from the source directory:
#   docker compose --env-file /www/wwwroot/game-biu/config/.env up -d --no-build
# Add -f compose.turn.yaml only when you also run the optional TURN relay.

# ---- Public application address ----
# Configure the public listener or reverse proxy according to your deployment.
APP_BIND_IP=0.0.0.0
APP_PORT=32741
CSRF_ALLOWED_ORIGINS=https://game.example.com
TRUST_PROXY=1
TZ=Asia/Shanghai

# ---- Application bootstrap ----
# ADMIN_PASSWORD must be at least 12 characters. It only seeds an empty database.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=CHANGE_ME_admin_password_at_least_12_chars

# ---- MySQL ----
MYSQL_DATABASE=games_online
MYSQL_USER=games
MYSQL_PASSWORD=CHANGE_ME_mysql_app_password
MYSQL_ROOT_PASSWORD=CHANGE_ME_mysql_root_password

# ---- Host paths (optional) ----
# Override only when the persistent directories live somewhere else.
# GAME_DATA_DIR=/www/wwwroot/game-biu/data
# GAME_CONFIG_DIR=/www/wwwroot/game-biu/config
# GAME_MYSQL_DIR=/www/wwwroot/game-biu/mysql
# GAME_TURN_DIR=/www/wwwroot/game-biu/coturn

# ---- Optional TURN relay ----
# Leave this whole block empty unless you start Compose with compose.turn.yaml.
# Cross-network rooms then use RELAY credentials distributed at runtime.
# TURN_PUBLIC_HOST=turn.example.com
# TURN_PUBLIC_IP=203.0.113.25
# TURN_LISTENING_IP=192.0.2.25
# TURN_RELAY_IP=192.0.2.25
# TURN_REALM=games-online
# TURN_PORT=45123
# TURN_MIN_PORT=45124
# TURN_MAX_PORT=45129
# TURN_USERNAME=games
# TURN_PASSWORD=CHANGE_ME_turn_password

# Set to 1 temporarily to force relay-only traffic while testing TURN.
VITE_WEBRTC_FORCE_RELAY=0

# ---- Application limits ----
MAX_UPLOAD_BYTES=104857600
MAX_STATE_BYTES=8388608
USER_UPLOAD_QUOTA_BYTES=2147483648
MAX_SAVE_SLOT=9

# Leave empty to auto-detect /app/config/.env, /app/config/app.env or /app/config/app.json.
APP_CONFIG_FILE=

# ---- Image ----
# Pin a release tag such as ghcr.io/xiaoxin0125/game-biubiubiu:v1.1.0 for reproducible upgrades.
APP_IMAGE=ghcr.io/xiaoxin0125/game-biubiubiu:latest
